<Page x:Class="ModernFileCleaner.Pages.InstallerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="App Installer">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="&#xE7F4;" FontFamily="/Wpf.Ui;Component/Resources/Font/#Segoe Fluent Icons" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="App Installer" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Silently install popular apps via winget (like Ninite)" FontSize="13" Foreground="#FF888888"/>
                </StackPanel>
            </StackPanel>

            <!-- Category sections -->
            <TextBlock Text="🌐  BROWSERS" Foreground="#FF0078D4" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>
            <StackPanel x:Name="BrowsersPanel" Margin="0,0,0,24"/>

            <TextBlock Text="🎬  MEDIA" Foreground="#FFFF9800" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>
            <StackPanel x:Name="MediaPanel" Margin="0,0,0,24"/>

            <TextBlock Text="💬  MESSAGING" Foreground="#FF4CAF50" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>
            <StackPanel x:Name="MessagingPanel" Margin="0,0,0,24"/>

            <TextBlock Text="🧰  UTILITIES" Foreground="#FFE91E63" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>
            <StackPanel x:Name="UtilitiesPanel" Margin="0,0,0,24"/>

            <TextBlock Text="📝  EDITORS" Foreground="#FF00BCD4" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>
            <StackPanel x:Name="EditorsPanel" Margin="0,0,0,24"/>

            <TextBlock Text="🔧  RUNTIMES &amp; LIBRARIES" Foreground="#FFFF5722" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>
            <StackPanel x:Name="RuntimesPanel" Margin="0,0,0,24"/>

            <TextBlock Text="🛡️  SECURITY" Foreground="#FF4CAF50" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>
            <StackPanel x:Name="SecurityPanel" Margin="0,0,0,24"/>

            <TextBlock Text="👨‍💻  DEVELOPMENT" Foreground="#FF8BC34A" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>
            <StackPanel x:Name="DevPanel" Margin="0,0,0,24"/>

            <TextBlock Text="🎮  GAMING" Foreground="#FF9C27B0" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>
            <StackPanel x:Name="GamingPanel" Margin="0,0,0,24"/>

            <!-- Install Button -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,12">
                <ui:Button x:Name="btnInstall" Content="⬇  Install Selected" Appearance="Primary" Width="200" Height="40" Click="Install_Click"/>
            </StackPanel>

            <!-- Status -->
            <TextBlock x:Name="txtStatus" Text="Select apps and click Install" Foreground="#FF888888" HorizontalAlignment="Center" FontSize="13" Margin="0,0,0,16"/>
        </StackPanel>
    </ScrollViewer>
</Page>
