<Page x:Class="ModernFileCleaner.Pages.InstallerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:ModernFileCleaner.Models"
      Title="App Installer">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="&#xE7F4;" FontFamily="/Wpf.Ui;Component/Resources/Font/#Segoe Fluent Icons" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="App Installer" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Silently install popular apps via winget (like Ninite)" FontSize="13" Foreground="#FF888888"/>
            </StackPanel>
        </StackPanel>

        <!-- App List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <ItemsControl x:Name="AppsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:InstallableApp}">
                        <Border CornerRadius="8" Background="#FF2D2D2D" BorderBrush="#FF3D3D3D" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ui:ToggleSwitch IsChecked="{Binding IsSelected}" Content="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Install Button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <ui:Button x:Name="btnInstall" Content="⬇  Install Selected" Appearance="Primary" Width="200" Height="40" Click="Install_Click"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock x:Name="txtStatus" Grid.Row="3" Text="Select apps and click Install" Foreground="#FF888888" HorizontalAlignment="Center" FontSize="13"/>
    </Grid>
</Page>
